# Hostinger Web App — copy into hPanel → Environment (do not commit secrets).
# Do not set DATABASE_URL, VITE_API_BASE, or DB_TYPE=mysql unless you use MySQL.

# --- SQLite (simple; data lives in DATABASE_PATH — may reset on redeploy unless you use MySQL) ---
DATABASE_PATH=data/bookings.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- MySQL (persistent) — uncomment and remove sqlite-only vars above ---
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Optional: payment return URL (no trailing slash)
# PUBLIC_BASE_URL=https://yellow-newt-288284.hostingersite.com
