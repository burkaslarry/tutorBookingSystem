# Copy to .env. The server reads it on startup and does not override existing variables.
# Do not commit .env or live secrets.

# Leave VITE_API_BASE empty when the browser and API share the same origin (Hostinger / local npm start).
# VITE_API_BASE=

# PORT=8000
# HOST=0.0.0.0
# DATABASE_PATH=./data/bookings.db
# UPLOADS_DIR=./data/uploads

# Optional: Render Postgres (local dev or Render deploy). Unused when DB_TYPE=mysql.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# PGSSL=true
# PGSSLMODE=require

# Hostinger production (recommended): MySQL only. Do not set DATABASE_URL on Hostinger.
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false

# Seeded admin username. When ADMIN_PASSWORD is set, that password is applied on startup (min 12 chars for mysql/postgres).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Public origin for KPay return and notify URLs. No trailing slash.
# PUBLIC_BASE_URL=http://localhost:8000

# Hours before the session to email an attendance reminder. Default 24.
# REMINDER_HOURS_BEFORE=24
# Minutes a pending KPay booking holds a seat. Default 15.
# KPAY_HOLD_MINUTES=15

# Resend (https://resend.com). Mail is skipped until both values are set.
# RESEND_API_KEY=
# RESEND_FROM=AI 學習中心 <bookings@your-domain.com>

# KPay hosted checkout. Leave KPAY_ENABLED unset until the merchant pack is available.
# KPAY_ENABLED=false
# KPAY_API_BASE=
# KPAY_CREATE_PATH=/v1/payment_intents
# KPAY_MERCHANT_ID=
# KPAY_APP_ID=
# KPAY_API_SECRET=
# KPAY_WEBHOOK_SECRET=
# KPAY_CURRENCY=HKD
