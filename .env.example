# Copy to .env. The server reads it on startup and does not override existing variables.
# Do not commit .env or live secrets.

# Leave empty when the page and API are on the same host. Hostinger's Vite build should set the Render API.
# VITE_API_BASE=https://tutorbookingsystem.onrender.com

# PORT=8000
# HOST=0.0.0.0
# DATABASE_PATH=./data/bookings.db
# UPLOADS_DIR=./data/uploads

# Required for local and production. Same Render Postgres database as StorySeed.
# Tables are prefixed johnny_ai_tutor_. Use the external URL outside Render.
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-d6iok5q4d50c738643c0-a.singapore-postgres.render.com/eventxp?sslmode=require
# PGSSL=true
# PGSSLMODE=require

# Hostinger MySQL is unused when DATABASE_URL is set.
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false

# Seeded admin username. When ADMIN_PASSWORD is set, that password is applied on startup.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Public origin for KPay return and notify URLs. No trailing slash.
# PUBLIC_BASE_URL=http://localhost:8000

# Hours before the session to email an attendance reminder. Default 24.
# REMINDER_HOURS_BEFORE=24
# Minutes a pending KPay booking holds a seat. Default 15.
# KPAY_HOLD_MINUTES=15

# Resend (https://resend.com). Mail is skipped until both values are set.
# RESEND_API_KEY=
# RESEND_FROM=AI 學習中心 <bookings@your-domain.com>

# KPay hosted checkout. Leave KPAY_ENABLED unset until the merchant pack is available.
# Amounts are sent as integer minor units (HKD cents) on a payment intent.
# Set KPAY_API_BASE and KPAY_CREATE_PATH from the KPay onboarding documents.
# KPAY_ENABLED=false
# KPAY_API_BASE=
# KPAY_CREATE_PATH=/v1/payment_intents
# KPAY_MERCHANT_ID=
# KPAY_APP_ID=
# KPAY_API_SECRET=
# KPAY_WEBHOOK_SECRET=
# KPAY_CURRENCY=HKD
